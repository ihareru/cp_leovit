# ============================================================
# Django
# ============================================================

DJANGO_SETTINGS_MODULE=config.settings.production

DEBUG=False

SECRET_KEY=

ALLOWED_HOSTS=cp.leovit.ru

CSRF_TRUSTED_ORIGINS=https://cp.leovit.ru


# ============================================================
# PostgreSQL
# ============================================================

DATABASE_URL=postgresql://leovit_portal_user:CHANGE_ME@127.0.0.1:5432/leovit_portal


# ============================================================
# Exchange ActiveSync
# ============================================================

EMAIL_BACKEND=apps.notifications.backends.activesync.ActiveSyncEmailBackend

DEFAULT_FROM_EMAIL=Leovit Portal <cpservice@leovit.ru>

ACTIVESYNC_URL=https://mail.leovit.ru/Microsoft-Server-ActiveSync

ACTIVESYNC_USERNAME=LEOVIT\cpservice

ACTIVESYNC_PASSWORD=

ACTIVESYNC_SENDER_EMAIL=cpservice@leovit.ru

ACTIVESYNC_PROTOCOL_VERSION=12.1

ACTIVESYNC_DEVICE_ID=LeovitPortalProd001

ACTIVESYNC_DEVICE_TYPE=LeovitPortal

ACTIVESYNC_TIMEOUT=30

ACTIVESYNC_SAVE_IN_SENT=False


# ============================================================
# Password reset
# ============================================================

PASSWORD_RESET_SECRET_KEY=

PASSWORD_RESET_TRUSTED_PROXY_NETWORKS=127.0.0.1/32

PASSWORD_RESET_MAX_CONFIRM_REQUESTS_PER_IP=100

PASSWORD_RESET_MAX_CONFIRM_REQUESTS_PER_EMAIL=15


# ============================================================
# Password reset cleanup
# ============================================================

PASSWORD_RESET_CODE_RETENTION_DAYS=7

PASSWORD_RESET_RATE_LIMIT_RETENTION_HOURS=24

PASSWORD_RESET_CLEANUP_BATCH_SIZE=1000
