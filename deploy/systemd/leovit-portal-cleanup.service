[Unit]
Description=Leovit Portal Password Reset Cleanup
After=network.target postgresql.service

[Service]
Type=oneshot

User=leovit-portal
Group=leovit-portal

WorkingDirectory=/var/www/corporate_portal

Environment=DJANGO_SETTINGS_MODULE=config.settings.production
Environment=PYTHONUNBUFFERED=1

ExecStart=/var/www/corporate_portal/.venv/bin/python /var/www/corporate_portal/manage.py cleanup_password_reset

TimeoutStartSec=300

UMask=0077
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
